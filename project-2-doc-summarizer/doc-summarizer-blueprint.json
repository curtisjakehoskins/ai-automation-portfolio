            "id": 2,
            "module": "gemini-ai:simpleTextPrompt",
            "version": 1,
            "parameters": {},
            "mapper": {
                "model": "gemini-2.5-flash",
                "textPrompt": "You are an operational intelligence assistant. Analyze the incoming text document and output ONLY a valid JSON object matching this schema:\n\n{\n  \"key_metrics\": [\"list of explicit quantitative numbers, percentages, or timeframes mentioned\"],\n  \"primary_bottleneck\": \"1 sentence describing the main pain point or issue\",\n  \"action_items\": [\n    {\n      \"owner\": \"Name of person responsible\",\n      \"task\": \"Task description\",\n      \"deadline\": \"Deadline or timeframe mentioned\"\n    }\n  ],\n  \"sentiment_status\": \"Critical | Concerned | Neutral | Positive\"\n}\n\nDo not include any conversational filler, markdown code fences, or preamble. Return raw JSON only.\n\nUser message:\nTitle: [click source_title from Webhook]\nAuthor: [click author from Webhook]\nDocument Text: [click raw_text from Webhook]"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "setupValidation": {
                    "version": 1,
                    "configuration": "6789d8f273b28b34",
                    "result": {
                        "valid": true,
                        "fields": []
                    }
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "Gemini 2.5 FlashApplies smart reasoning to fast data tasks while ensuring quick response times"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "model",
                        "type": "select",
                        "label": "Model",
                        "required": true,
                        "validate": {
                            "enum": [
                                "gemini-2.5-flash",
                                "gemini-3.8-flash",
                                "gemini-3.7-flash",
                                "gemini-3.6-flash",
                                "gemini-3.5-flash",
                                "gemini-3.1-pro-preview",
                                "gemini-3-flash-preview",
                                "gemini-2.5-pro"
                            ]
                        }
                    },
                    {
                        "name": "textPrompt",
                        "type": "text",
                        "label": "Text prompt",
                        "required": true
                    }
                ]
            },
            "onerror": [
                {
                    "id": 3,
                    "module": "builtin:Resume",
                    "version": 1,
                    "parameters": {},
                    "mapper": {
                        "result": "{\"key_metrics\": [\"None\"], \"primary_bottleneck\": \"Automated extraction failed due to API timeout.\", \"action_items\": [], \"sentiment_status\": \"Neutral\"}",
                        "blockReason": "",
                        "finishReason": "stop",
                        "finishMessage": "Fallback due to API timeout",
                        "usageMetadata": {
                            "promptTokenCount": "",
                            "outputTokenCount": ""
                        },
                        "baseModel": "default",
                        "modelVersion": "default"
                    },
                    "metadata": {
                        "designer": {
                            "x": 600,
                            "y": 0
                        },
                        "restore": {
                            "expect": {
                                "blockReason": {
                                    "collapsed": true
                                },
                                "finishReason": {
                                    "collapsed": true
                                },
                                "finishMessage": {
                                    "collapsed": true
                                },
                                "usageMetadata": {
                                    "collapsed": true,
                                    "nested": {
                                        "promptTokenCount": {
                                            "collapsed": true
                                        },
                                        "outputTokenCount": {
                                            "collapsed": true
                                        }
                                    }
                                },
                                "baseModel": {
                                    "collapsed": true
                                },
                                "modelVersion": {
                                    "collapsed": true
                                }
                            }
                        },
                        "expect": [
                            {
                                "name": "result",
                                "type": "text",
                                "label": "Result"
                            },
                            {
                                "name": "blockReason",
                                "type": "text",
                                "label": "Block reason"
                            },
                            {
                                "name": "finishReason",
                                "type": "text",
                                "label": "Finish reason"
                            },
                            {
                                "name": "finishMessage",
                                "type": "text",
                                "label": "Finish message"
                            },
                            {
                                "name": "usageMetadata",
                                "type": "collection",
                                "label": "Usage",
                                "spec": [
                                    {
                                        "name": "promptTokenCount",
                                        "type": "number",
                                        "label": "Input tokens"
                                    },
                                    {
                                        "name": "outputTokenCount",
                                        "type": "number",
                                        "label": "Output tokens"
                                    }
                                ]
                            },
                            {
                                "name": "baseModel",
